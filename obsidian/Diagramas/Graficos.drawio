        <mxCell id="YXx9BxjXFM60DNCwBHbt-2" value="&lt;b&gt;EQUIPO&amp;nbsp;&lt;/b&gt;&lt;div&gt;&lt;b&gt;ARQUITECTOS&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;b&gt;LOCAL&lt;/b&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Terraform&lt;br&gt;App Service&lt;div&gt;Service Plan&lt;/div&gt;&lt;div&gt;Private link&lt;/div&gt;&lt;div&gt;key vault&lt;/div&gt;&lt;div&gt;12-13 recursos más&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
